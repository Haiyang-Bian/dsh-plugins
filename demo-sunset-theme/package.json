{
  "name": "demo-sunset-theme",
  "version": "0.10.0",
  "description": "Sunset, gradient Aurora and textured Sage themes with appearance and font controls in DSH General settings.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dist/client.js",
    "README.md",
    "VALIDATION.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "prepack": "tsc --noEmit && vite build"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@types/react": "~18.3.31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "demo"
  ],
  "license": "MIT"
}
